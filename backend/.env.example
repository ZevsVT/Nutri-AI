NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL connection used by Prisma and the backend readiness check. Set
# this only after replacing the local placeholders below with matching values.
DATABASE_URL=
POSTGRES_DB=nutri_ai
POSTGRES_USER=nutri_ai
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# Required in staging/production, but not used for authentication until Issue #8.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Comma-separated; do not use * for authenticated production APIs.
CORS_ORIGINS=http://localhost:5173

STORAGE_PROVIDER=none
STORAGE_BUCKET=

AI_PROVIDER=none
AI_API_KEY=

NUTRITION_PROVIDER=none
NUTRITION_API_KEY=

LOG_LEVEL=info
AUTH_DEV_MODE=false
REQUEST_BODY_LIMIT_BYTES=1048576
FILE_UPLOAD_LIMIT_BYTES=10485760
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
EXTERNAL_REQUEST_TIMEOUT_MS=10000
EXTERNAL_RETRY_LIMIT=2
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false
