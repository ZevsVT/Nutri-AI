NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL connection used by Prisma and the backend readiness check. Set
# this only after replacing the local placeholders below with matching values.
DATABASE_URL=
POSTGRES_DB=nutri_ai
POSTGRES_USER=nutri_ai
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# Retained for compatibility with the foundation configuration; sessions are
# used for browser authentication.
JWT_SECRET=
JWT_EXPIRES_IN=15m
AUTH_SESSION_TTL_HOURS=720
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated; do not use * for authenticated production APIs.
CORS_ORIGINS=http://localhost:5173

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_ROOT=.data/storage
STORAGE_READ_URL_TTL_SECONDS=900
STORAGE_TEMPORARY_TTL_HOURS=24
STORAGE_RETENTION_DAYS=30

AI_PROVIDER=none
AI_API_KEY=

NUTRITION_PROVIDER=none
NUTRITION_API_KEY=

LOG_LEVEL=info
AUTH_DEV_MODE=false
REQUEST_BODY_LIMIT_BYTES=1048576
FILE_UPLOAD_LIMIT_BYTES=10485760
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
EXTERNAL_REQUEST_TIMEOUT_MS=10000
EXTERNAL_RETRY_LIMIT=2
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false
